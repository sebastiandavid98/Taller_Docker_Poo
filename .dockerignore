# ============================================================
# .dockerignore - eco-air-backend
# Este archivo le dice a Docker que NO copiar al contexto
# de construccion. Reduce el tamano y evita filtrar secretos.
# ============================================================

# Carpeta de compilacion local (no la necesitamos, Maven compila dentro del contenedor)
target/

# Archivos de Git (no son parte de la aplicacion)
.git/
.gitignore
.gitattributes

# Archivos del IDE IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Archivos del IDE Eclipse / VS Code
.classpath
.project
.settings/
.vscode/

# Logs locales
*.log
logs/

# Archivos de entorno local (pueden tener secrets)
.env
.env.*

# Documentacion y archivos del taller (no van en la imagen)
*.md
*.docx
*.pdf

# Sistema operativo Mac
.DS_Store

# Archivos de Docker (no se auto-referencian)
Dockerfile*
docker-compose*
